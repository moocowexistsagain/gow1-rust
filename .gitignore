*.iso
*.bin
*.elf
SLUS_*
SLES_*
SCUS_*
SLPM_*
*.PAK
*.pak
*.TOC
*.toc
*.WAD
*.wad
*.psarc

# Toolchain scratch / generated golden corpora (downloaded, not committed)
/.cache/
/tools/.cache/

# Recovered-but-not-yet-curated output
/out/

# Editors
*.swp
.idea/
.vscode/
